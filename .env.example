# YouTube Uploader Pro - Environment Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8080

# Supabase


# Firefox Profile (optional)
FIREFOX_PROFILE_PATH=./profile

# Upload Settings
MAX_RETRIES=3
RETRY_DELAY=10
LOG_LEVEL=INFO

# YouTube API (not required - uses Selenium)
# YOUTUBE_USERNAME=your_username
# YOUTUBE_PASSWORD=your_password

# Google OAuth 2.0 (for YouTube account connection)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_APP_NAME="YouTube Upload Pro"
